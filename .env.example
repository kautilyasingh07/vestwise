# Copy to .env and fill in real values. Never commit .env.

# MongoDB Atlas (M0 free cluster): Atlas UI -> Connect -> Drivers -> Python
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_DB=vestwise

# LLM: "gemini" or "groq". Only the key for the chosen provider is required.
LLM_PROVIDER=gemini
# Optional; defaults to gemini-2.5-flash (gemini) or llama-3.3-70b-versatile (groq)
LLM_MODEL=
GOOGLE_API_KEY=<your-google-ai-studio-key>
GROQ_API_KEY=<your-groq-key>

# Embeddings and retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35

# Domain: must match the exercise window stated in the ESOP policy
EXERCISE_WINDOW_DAYS=90

# Streamlit UI -> FastAPI
API_URL=http://localhost:8000
