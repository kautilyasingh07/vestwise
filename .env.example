# Copy to .env and fill in real values. Never commit .env.

# MongoDB Atlas (M0 free cluster): Atlas UI -> Connect -> Drivers -> Python
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGO_DB=vestwise

# LLM: "gemini" or "groq". Only the key for the chosen provider is required.
LLM_PROVIDER=groq
# Required, no default (provider model names get retired). Development model:
#   groq   -> openai/gpt-oss-120b
#   gemini -> e.g. gemini-3.5-flash (free tier: 20 requests/day per model)
LLM_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=<your-google-ai-studio-key>
GROQ_API_KEY=<your-groq-key>

# Embeddings and retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_INDEX_NAME=chunks_vector_index
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35

# Domain: must match the exercise window stated in the ESOP policy
EXERCISE_WINDOW_DAYS=90

# Streamlit UI -> FastAPI
API_URL=http://localhost:8000
